# ============================================================
# ThreatIntelX environment configuration
# Copy this file to .env and adjust values as needed.
# Sensible defaults are provided so `docker compose up --build`
# works immediately with zero configuration.
# ============================================================

# --- General ---
ENV=development
DEBUG=true

# --- Database ---
POSTGRES_DB=threatintelx
POSTGRES_USER=threatintelx
POSTGRES_PASSWORD=threatintelx
# DATABASE_URL overrides the individual POSTGRES_* values if set, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# IMPORTANT: change this to a long random string before any real deployment.
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Initial admin account (created on first startup) ---
ADMIN_EMAIL=admin@threatintelx.local
ADMIN_PASSWORD=ChangeMe123!

# --- Demo mode ---
# When true, the platform seeds itself with safe synthetic threat
# intelligence so the dashboard is populated immediately, even with
# no external feeds or API keys configured.
DEMO_MODE=true

# --- Optional external enrichment / feed API keys ---
# The platform runs fully without these. If left blank, enrichment
# falls back to internal heuristics and external status is reported
# as "unavailable" rather than the app crashing.
API_KEY_1=
API_KEY_2=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Scheduler intervals ---
FEED_INTERVAL_MINUTES=30
ENRICHMENT_INTERVAL_MINUTES=60
CORRELATION_INTERVAL_MINUTES=60
CLEANUP_INTERVAL_HOURS=24
